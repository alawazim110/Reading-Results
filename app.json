const STAGES_COUNT = 6;
const CLASSES_PER_STAGE = 4;
const MAX_RESULTS = 5;

// 1. إنشاء واجهة اختيار المرحلة والفصل في الصفحة الرئيسية
function renderGradeSelection() {
    const container = document.getElementById("grades-container");
    if (!container) return;

    for (let stage = 1; stage <= STAGES_COUNT; stage++) {
        const stageCard = document.createElement("div");
        stageCard.className = "card grade-card";
        
        let buttonsHTML = "";
        for (let cls = 1; cls <= CLASSES_PER_STAGE; cls++) {
            buttonsHTML += `
                <a href="class-report.html?stage=${stage}&class=${cls}" class="class-btn">
                    فصل ${stage}/${cls}
                </a>
            `;
        }

        stageCard.innerHTML = `
            <h3>الصف ${stage} الابتدائي</h3>
            <div class="class-buttons">${buttonsHTML}</div>
        `;
        container.appendChild(stageCard);
    }
}

// 2. قراءة رقم المرحلة والفصل من رابط الصفحة
function getUrlParams() {
    const params = new URLSearchParams(window.location.search);
    return {
        stage: params.get("stage") || 1,
        classNum: params.get("class") || 1
    };
}

// 3. تحميل صفحة تقرير الفصل
async function loadClassReport() {
    const { stage, classNum } = getUrlParams();
    const titleElem = document.getElementById("class-title");
    if (titleElem) {
        titleElem.textContent = `تقرير نتائج الصف ${stage} الابتدائي - فصل ${stage}/${classNum}`;
    }

    renderTableByClass(stage, classNum);
}

// 4. إضافة نتيجة جديدة برقم الهوية (حفظ أحدث 5 نتائج وحذف الأقدم)
function addScoreById(nationalId, score) {
    let allScores = JSON.parse(localStorage.getItem("students_scores")) || {};

    if (!allScores[nationalId]) {
        allScores[nationalId] = [];
    }

    allScores[nationalId].push(Number(score));

    // إذا تجاوزت النتائج 5، يتم إزالة النتيجة الأقدم تلقائياً
    if (allScores[nationalId].length > MAX_RESULTS) {
        allScores[nationalId].shift();
    }

    localStorage.setItem("students_scores", JSON.stringify(allScores));
}

// 5. حساب نسبة التقدم الإجمالية من أول نتيجة ثبتت إلى أحدث نتيجة
function calculateProgress(scores) {
    if (!scores || scores.length < 2) return 0;
    
    const firstScore = scores[0];
    const lastScore = scores[scores.length - 1];

    if (firstScore === 0) return 0;

    const progress = ((lastScore - firstScore) / firstScore) * 100;
    return progress.toFixed(2);
}

// 6. عرض جدول نتائج الفصل بناءً على رقم الهوية والبيانات من students.json
async function renderTableByClass(stageNum, classNum) {
    const tbody = document.getElementById("report-table-body");
    if (!tbody) return;
    tbody.innerHTML = "";

    try {
        const response = await fetch('students.json');
        const allData = await response.json();
        
        const allScores = JSON.parse(localStorage.getItem("students_scores")) || {};
        const classKey = `class_${stageNum}_${classNum}`;
        const studentsInClass = allData[classKey] || [];

        if (studentsInClass.length === 0) {
            tbody.innerHTML = `<tr><td colspan="6">لا يوجد طلاب مسجلون في هذا الفصل داخل ملف students.json.</td></tr>`;
            return;
        }

        studentsInClass.forEach(student => {
            const studentId = student.id;
            const studentName = student.name;
            const scores = allScores[studentId] || [];

            const firstScore = scores.length > 0 ? scores[0] : "-";
            const lastScore = scores.length > 0 ? scores[scores.length - 1] : "-";
            const progress = calculateProgress(scores);

            const progressClass = progress >= 0 ? "progress-positive" : "progress-negative";
            const progressSign = progress >= 0 ? "+" : "";

            const row = document.createElement("tr");
            row.innerHTML = `
                <td>${studentId}</td>
                <td><strong>${studentName}</strong></td>
                <td>${scores.length > 0 ? scores.join(", ") : "لا توجد نتائج بعد"}</td>
                <td>${firstScore}</td>
                <td>${lastScore}</td>
                <td class="${progressClass}">${scores.length >= 2 ? progressSign + progress + "%" : "-"}</td>
            `;
            tbody.appendChild(row);
        });

    } catch (error) {
        console.error("خطأ في قراءة ملف students.json", error);
        tbody.innerHTML = `<tr><td colspan="6">تعذر قراءة ملف البيانات students.json</td></tr>`;
    }
}

// 7. معالجة زر تسليم النتيجة من الصفحة
async function handleAddScore() {
    const { stage, classNum } = getUrlParams();
    const inputField = document.getElementById("student-name"); // يمكن إدخال رقم الهوية هنا
    const scoreInput = document.getElementById("student-score");

    const inputVal = inputField.value.trim();
    const scoreVal = scoreInput.value;

    if (!inputVal || scoreVal === "") {
        alert("يرجى إدخال رقم الهوية والنتيجة");
        return;
    }

    addScoreById(inputVal, scoreVal);
    inputField.value = "";
    scoreInput.value = "";
    renderTableByClass(stage, classNum);
}